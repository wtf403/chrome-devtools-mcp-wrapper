{
  "name": "chrome-devtools-mcp-wrapper",
  "version": "0.1.1",
  "description": "MCP wrapper for chrome-devtools-mcp with dynamic multi-browser routing — connect to multiple Chrome instances and switch between them at runtime",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "chrome-devtools-mcp-wrapper": "./dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin.js",
    "dev": "tsc --watch",
    "test": "npm run build && node test/smoke.js"
  },
  "keywords": [
    "mcp",
    "chrome-devtools",
    "cdp",
    "browser-automation",
    "model-context-protocol",
    "claude",
    "ai-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wtf403/chrome-devtools-mcp.git"
  },
  "homepage": "https://github.com/wtf403/chrome-devtools-mcp#readme",
  "bugs": {
    "url": "https://github.com/wtf403/chrome-devtools-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/node": "22.15.29"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
